# Domain the ingress serves. Replaced by DOMAIN from your overlay (components/domain), which
# also puts it into PUBLIC_URL.
DOMAIN=webtorrentio.example.com
PUBLIC_URL=https://webtorrentio.example.com
# The ingress terminates HTTPS; the pod speaks plain HTTP.
HTTPS=off
MAX_ACTIVE_TORRENTS=5
MAX_TORRENTS_PER_USER=2
# Keep MAX_DISK_GB below the size of the torrent-data volume (pvc.yaml).
MAX_DISK_GB=40
MAX_DISK_PER_STREAM_MB=4096
