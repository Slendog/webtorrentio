# Copy to .env and edit.

# URL that Stremio uses to reach the server.
#   docker-compose.yml:        http://<server-ip>:7000
#   docker-compose.https.yml:  https://<DOMAIN>
PUBLIC_URL=http://your-server-ip:7000

# Only for docker-compose.https.yml: the domain Caddy gets a Let's Encrypt certificate for,
# and an optional email address for certificate expiry notices.
DOMAIN=addon.example.com
# ACME_EMAIL=you@example.com

# One entry per user, name:token. Generate tokens with:
#   docker compose run --rm addon node scripts/token.js
ACCESS_TOKENS=alice:change-me,bob:change-me-too

# Built-in HTTPS: auto (when a working certificate exists), on (required), off.
# docker-compose.https.yml sets off for the addon, because Caddy does HTTPS there.
# HTTPS=auto
# TLS_CERT=/app/certs/cert.pem
# TLS_KEY=/app/certs/key.pem

# Interface to listen on. The Docker image sets 0.0.0.0; outside Docker the default is
# 127.0.0.1 (or 0.0.0.0 when PUBLIC_URL is not a loopback address).
# HOST=0.0.0.0
# Extra host names allowed in the Host header, comma-separated (the PUBLIC_URL host always is).
# ALLOWED_HOSTS=

# Hard limits.
MAX_ACTIVE_TORRENTS=5
MAX_TORRENTS_PER_USER=2
MAX_DISK_GB=50
MAX_DISK_PER_STREAM_MB=4096
# READAHEAD_MB=256

# Optional.
# STREAM_MODE=webtorrent
# Torrent indexes to search: none by default. Comma-separated keys
# (yts, tpb, eztv, nyaa, 1337x) or "all". Users can also choose per install in Stremio's
# Configure page. Only stream content you have the right to access.
# SCRAPERS=
# TORRENT_IDLE_MS=120000
# Stereo audio conversion (fixes pops from players' 5.1 downmix): conversions at once, 0 = off.
# AUDIO_CONVERSIONS=2
